option types_output = "./out/attributes_types"
option server_output = "./out/attributes_server"
option client_output = "./out/attributes_client"

-- manually step replication in a test harness
@profile("test") 
option manual_replication = true

-- restrict entire features to dev builds
@profile("dev") 
from "./libs/debugger" import * as debugger

-- restrict individual items
@profile("dev")
type command = union "name" {
	give {
		item: u32,
		amount: u8
	},
	clear {}
}

@profile("dev")
event give_money = {
	from: Client,
	type: Reliable,
	call: SingleSync,
	data: u32
}